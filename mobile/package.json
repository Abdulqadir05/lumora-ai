{
  "name": "lumora-ai",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc -p .",
    "test": "jest",
    "test:e2e": "jest e2e",
    "test:distribution": "node --test scripts/distribution.test.mjs",
    "doctor": "npx expo-doctor@latest",
    "export:check": "expo export --platform android --platform ios --output-dir dist",
    "brand:assets": "node scripts/brand-assets.mjs",
    "verify:release": "node scripts/check-release-env.mjs --profile=testflight && node scripts/check-release-env.mjs --profile=ios-adhoc && node scripts/check-release-env.mjs --profile=android-apk",
    "eas-build-pre-install": "node scripts/check-release-env.mjs",
    "build:android:apk": "eas build --platform android --profile android-apk",
    "build:ios:adhoc": "eas build --platform ios --profile ios-adhoc",
    "build:ios:testflight": "eas build --platform ios --profile testflight",
    "submit:ios:testflight": "eas submit --platform ios --profile testflight --latest",
    "release:ios:testflight": "eas build --platform ios --profile testflight --auto-submit",
    "devices:register": "eas device:create",
    "devices:list": "eas device:list",
    "resign:ios:adhoc": "eas build:resign --platform ios --target-profile ios-adhoc --source-profile ios-adhoc",
    "testflight:setup": "node scripts/testflight.mjs setup",
    "testflight:distribute": "node scripts/testflight.mjs distribute",
    "testflight:status": "node scripts/testflight.mjs status"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@ronradtke/react-native-markdown-display": "8.1.0",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@ronradtke/.*|react-native-fit-image)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/scripts/distribution\\.test\\.mjs$"
    ]
  },
  "overrides": {
    "markdown-it": "^14.1.1",
    "glob@10": "14.0.3",
    "glob@13": "14.0.3",
    "minimatch@10": "11.0.1"
  },
  "pnpm": {
    "overrides": {
      "markdown-it": "^14.1.1",
      "glob@10": "14.0.3",
      "glob@13": "14.0.3",
      "minimatch@10": "11.0.1"
    }
  }
}
