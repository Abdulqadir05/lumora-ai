# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
# If behind a TLS-terminating proxy, list its exact IP/CIDR(s), comma-separated.
# The proxy must overwrite X-Forwarded-Proto; keep the backend reachable only by it.
# Production rejects numeric hop counts. Leave blank when TLS terminates in Node.
TRUST_PROXY=

# Comma-separated tokens accepted in "Authorization: Bearer <token>".
# REQUIRED in production; every token must be at least 32 bytes. Generate with:
# openssl rand -hex 32
# A shared token embedded in an APK can be extracted. Add user-scoped auth and
# per-user usage controls before unrestricted public distribution.
LUMORA_CLIENT_TOKENS=

# ─── LLM provider (any OpenAI-compatible Chat Completions API) ──────────────
# Groq (default): https://api.groq.com/openai/v1
# OpenAI:         https://api.openai.com/v1
# Gemini:         https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER_NAME=Groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# Provider model IDs mapped to Lumora's public model IDs. A model whose ID is
# not returned by the provider's /models endpoint is reported as unavailable.
MODEL_GPT_OSS_20B=openai/gpt-oss-20b
MODEL_GPT_OSS_120B=openai/gpt-oss-120b
# Groq currently lists Qwen 3.8 27B as Preview; availability and lifecycle can change.
MODEL_QWEN_38_27B=qwen/qwen3.8-27b

# ─── Live tools ──────────────────────────────────────────────────────────────
# Web search (Tavily). Without it, web search is reported as not configured and
# only Wikipedia is used as a fallback for factual lookups.
TAVILY_API_KEY=
# Optional CoinGecko demo key (raises public rate limits).
COINGECKO_DEMO_API_KEY=
# Google News RSS locale.
NEWS_HL=en-US
NEWS_GL=US
NEWS_CEID=US:en
# Weather questions without a city ask the user which location to check.

# ─── Security tuning ─────────────────────────────────────────────────────────
# Exact browser origins allowed to call the API (not needed for the mobile app).
CORS_ORIGINS=
# Requests per minute per IP: all /api traffic (pre-auth), chat, and tools.
# The default express-rate-limit store is in-memory and per process; use a shared
# store plus per-user quotas before scaling or distributing publicly.
API_RATE_PER_MIN=120
CHAT_RATE_PER_MIN=20
TOOL_RATE_PER_MIN=60
